{
  "app_name": "Retro-DLP",
  "tag_prefix": "v",
  "version": {
    "source": "source/library/shared/Info.plist",
    "keys": [
      "CFBundleShortVersionString",
      "CFBundleVersion"
    ],
    "plists": [
      "source/library/shared/Info.plist",
      "source/gui/macOS/Info.plist",
      "source/gui/iOS/Info.plist"
    ]
  },
  "release": {
    "commit_message": "chore(release): release {version}"
  },
  "targets": [
    {
      "name": "macOS CLI",
      "workdir": ".",
      "build": [
        {
          "shell": "make macOS-clean"
        },
        {
          "shell": "make macOS"
        }
      ],
      "artifact": "build/macOS/release/retro-dlp/retro-dlp.zip",
      "asset_name": "Retro-DLP-{version}-macOS-cli.zip"
    },
    {
      "name": "iOS CLI",
      "workdir": ".",
      "build": [
        {
          "shell": "make iOS-clean"
        },
        {
          "shell": "make iOS"
        }
      ],
      "artifact": "build/iOS/release/retro-dlp/retro-dlp.zip",
      "asset_name": "Retro-DLP-{version}-iOS-cli.zip"
    },
    {
      "name": "macOS application",
      "workdir": ".",
      "build": [
        {
          "shell": "make app-macOS"
        }
      ],
      "artifact": "build/macOS/release/RetroDLP/RetroDLP.zip",
      "asset_name": "Retro-DLP-{version}-macOS-gui.zip"
    },
    {
      "name": "iOS application",
      "workdir": ".",
      "build": [
        {
          "shell": "make app-iOS"
        },
        {
          "shell": "make app-validate"
        }
      ],
      "artifact": "build/iOS/release/RetroDLP/RetroDLP.ipa",
      "asset_name": "Retro-DLP-{version}-iOS-gui.ipa"
    },
    {
      "name": "macOS Library",
      "workdir": ".",
      "build": [
        {
          "shell": "make macOS"
        },
        {
          "shell": "make validate-apple-artifacts"
        }
      ],
      "artifact": "build/macOS/release/libretrodlp/retro-dlp-library.zip",
      "asset_name": "Retro-DLP-{version}-macOS-library.zip"
    },
    {
      "name": "iOS Library",
      "workdir": ".",
      "build": [
        {
          "shell": "make iOS"
        },
        {
          "shell": "make validate-apple-artifacts"
        }
      ],
      "artifact": "build/iOS/release/libretrodlp/retro-dlp-library.zip",
      "asset_name": "Retro-DLP-{version}-iOS-library.zip"
    }
  ],
  "schema_version": 1,
  "stage_dir": "dist"
}
